# Copy to .env and fill in real values before connecting to live systems
FLASK_ENV=development
FLASK_SECRET_KEY=change-me-in-production

# Salesforce CRM (confirmed REST API — see D5)
SF_INSTANCE_URL=https://apex-distribution.salesforce.com
SF_ACCESS_TOKEN=

# Driver App GPS (API NOT YET CONFIRMED — see D6 Q1)
# Leave blank until Driver App team confirms endpoint
DRIVER_APP_BASE_URL=
DRIVER_APP_API_KEY=

# Comms gateway
SMS_PROVIDER_URL=
SMS_API_KEY=
EMAIL_PROVIDER_URL=
EMAIL_API_KEY=

# Mock mode (set to true to use mock_data/ instead of live APIs)
MOCK_MODE=true
